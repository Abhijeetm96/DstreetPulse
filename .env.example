# Indian Equity Swing Trading Intelligence System
# Environment Configuration Template

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Capital & Risk Thresholds
TRADING_EQUITY=108699.95
MAX_PLANNED_RISK_PER_TRADE_PCT=0.005
MAX_AGGREGATE_OPEN_RISK_PCT=0.02
MAX_SIMULTANEOUS_POSITIONS=5
MIN_REWARD_TO_RISK_RATIO=2.0

# Market Operating Parameters
MARKET=NSE
MARKET_TIMEZONE=Asia/Kolkata
PAPER_TRADING_MODE=true
LIVE_EXECUTION_ALLOWED=false

# Persistence Paths
JOURNAL_DB_PATH=./data/trading_journal.db
CONFIG_PATH=./config/trading_config.json
